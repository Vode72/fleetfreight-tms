# Copy to .env and change the values. Never commit real secrets.
POSTGRES_USER=fleetfreight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleetfreight

# Used by the backend. Inside docker compose the host is "db"; locally use localhost.
DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight

# Used by pytest only. The database name must end with "_test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight_test

# Runtime mode. "development" enables /docs, /redoc and /openapi.json and the demo seed command.
# Anything else (the default) is treated as production.
ENVIRONMENT=development

# Session cookie. Keep SESSION_COOKIE_SECURE=true in production (HTTPS only); plain-HTTP local
# development needs false.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_DAYS=7
# Store the client IP with each session (personal data): off by default.
SESSION_STORE_IP=false

# Login throttling: failed attempts allowed per IP+e-mail within the window.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Used only by `uv run python -m scripts.seed_demo_users`. Choose your own (min. 12 characters).
DEMO_PASSWORD=replace-with-your-own-demo-password
