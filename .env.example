# FOR DEVELOPMENT ONLY. These values (including the placeholder passwords) are not safe for
# production; set real secrets in the production environment instead.
# Copy to .env and change the values. Never commit real secrets.
POSTGRES_USER=fleetfreight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleetfreight

# Used by the backend. Inside docker compose the host is "db"; locally use localhost.
DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight

# Used by pytest only. The database name must end with "_test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight_test

# Runtime mode and cookie security are NOT set here, so a copied .env can never switch a
# production start into development mode. With Docker Compose, docker-compose.override.yml sets
# ENVIRONMENT=development and SESSION_COOKIE_SECURE=false for local use. When running the backend
# outside Docker (uv run uvicorn ...), uncomment both lines below in your own .env:
# ENVIRONMENT=development
# SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_DAYS=7
# Store the client IP with each session (personal data): off by default.
SESSION_STORE_IP=false

# Login throttling: failed attempts allowed per IP+e-mail within the window.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Used only by `uv run python -m scripts.seed_demo_users`. Choose your own (min. 12 characters).
DEMO_PASSWORD=replace-with-your-own-demo-password

# Secret key for the HMAC used to pseudonymise e-mail addresses in logs. Empty: a random key
# is generated at each start (log identifiers then change on restart).
LOG_HMAC_KEY=

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header is trusted (see
# backend/README.md). Empty (default): trust none. Never use "*".
TRUSTED_PROXY_IPS=
