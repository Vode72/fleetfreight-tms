# Copy to .env and change the values. Never commit real secrets.
POSTGRES_USER=fleetfreight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleetfreight

# Used by the backend. Inside docker compose the host is "db"; locally use localhost.
DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight

# Used by pytest only. The database name must end with "_test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://fleetfreight:change-me@localhost:5432/fleetfreight_test
